{% assign cf = trmnl.plugin_settings.custom_fields_values %}
<div class="layout layout--col gap--space-between">
  {% if entries.size > 0 -%}
    <div class="columns" data-overflow-max-cols="2" data-overflow-counter="true">
      <div class="column">
        {% for entry in entries -%}
          {%- render 'entry_card', entry: entry, show_category: cf.show_category -%}
        {%- endfor %}
      </div>
    </div>
  {%- else -%}
    {% render 'empty_state' %}
  {%- endif %}
</div>
{% render 'title_bar', instance_name: trmnl.plugin_settings.instance_name, direction: cf.direction %}
