{% template entry_card %}
<div class="item">
  <div class="meta"><span class="index"></span></div>
  <div class="content">
    <span class="title title--small" data-clamp="2">{{ entry.title }}</span>
    <div class="flex gap--small">
      <span class="label label--small label--underline">{{ entry.published_at | date: '%b %d, %Y' }}</span>
      <span class="label label--small label--underline">{{ entry.feed.title | truncate: 18 }}</span>
      {% unless show_category == false or show_category == 'false' %}
        <span class="label label--small label--inverted">{{ entry.feed.category.title }}</span>
      {% endunless %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template empty_state %}
<div class="text--center">
  <span class="title">You're fully caught up!</span>
</div>
{% endtemplate %}

